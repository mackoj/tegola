    "Hi %@! Hope you're enjoying %@. Tell me when you're done with it." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hi %1$@! Hope you're enjoying %2$@. Tell me when you're done with it."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salut %1$@ ! J’espère que %2$@ te plaît. Dis-moi quand tu as fini."
          }
        }
      }
    },
    "Hi %@! Just checking in on %@: it was due back %lld days ago. No rush, tell me when." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hi %1$@! Just checking in on %2$@: it was due back %3$lld days ago. No rush, tell me when."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salut %1$@ ! Petit mot pour %2$@ : il devait revenir il y a %3$lld jours. Rien ne presse, dis-moi."
          }
        }
      }
    },
    "In the house," : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chez vous,"
          }
        }
      }
    },
    "Lend something from its page and it shows here, with when it's due back." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prêtez un objet depuis sa page : il apparaît ici, avec sa date de retour."
          }
        }
      }
    },
