      }
    },
    "shelf yet" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "l’étagère"
          }
        }
      }
    },
    "Some things on your shelf wear out with time, like a game's save battery. Tegola can send a notification when one is probably due." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certaines choses de votre étagère s’usent avec le temps, comme la pile de sauvegarde d’un jeu. Tegola peut vous envoyer une notification quand l’une d’elles arrive probablement à échéance."
          }
        }
      }
    },
    "Start with one piece you love. Type it in, and the shelf grows from there." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commencez par une pièce que vous aimez. Tapez-la, et l’étagère grandit à partir de là."
          }
        }
      }
    },
    "Today" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aujourd’hui"
          }
        }
      }
    },
    "Type it" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La taper"
          }
        }
      }
    },
