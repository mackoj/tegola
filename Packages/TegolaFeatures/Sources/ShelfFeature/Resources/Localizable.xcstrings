      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envies"
          }
        }
      }
    },
    "Worth a look: an estimate says it's due." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À regarder : une estimation dit que c’est le moment."
          }
        }
      }
    },
    "Yes, tell me" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oui, prévenez-moi"
          }
        }
      }
