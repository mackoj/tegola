{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ aren't a full type yet. It's saved safely as a Thing." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les %@ ne sont pas encore un type complet. C’est rangé en sûreté comme un objet."
          }
        }
      }
    },
    "A gift" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un cadeau"
          }
        }
      }
    },
    "A line about it, if you like" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une ligne sur lui, si vous voulez"
          }
        }
      }
    },
    "Around %@. We'll tell you when it's time." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
