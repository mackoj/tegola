        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Donnez-lui un nom pour continuer."
          }
        }
      }
    },
    "Had it since I was a kid" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je l’ai depuis l’enfance"
